<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/scrollView" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:fillViewport="true">
<LinearLayout android:id="@+id/qrContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="30dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATTENDANCE" android:textColor="#2563EB" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.14"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Scan a class QR code" android:textColor="#172033" android:textSize="28sp" android:textStyle="bold" android:fontFamily="@font/poppins_bold"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="18dp" android:text="Use the active code provided by your teacher to record attendance." android:textColor="#64748B" android:textSize="13sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/qr_container_bg" android:orientation="horizontal" android:padding="14dp" android:gravity="center_vertical" android:layout_marginBottom="14dp"><ImageView android:layout_width="34dp" android:layout_height="34dp" android:layout_marginEnd="12dp" android:src="@drawable/ic_check_circle" android:tint="#16A34A"/><LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready to scan" android:textColor="#166534" android:textSize="13sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Only active attendance sessions can be used." android:textColor="#64748B" android:textSize="11sp"/></LinearLayout></LinearLayout>
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" xmlns:app="http://schemas.android.com/apk/res-auto" app:cardCornerRadius="20dp" app:cardElevation="0dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp" android:gravity="center" android:background="@drawable/card_surface"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE SESSIONS" android:textSize="10sp" android:textStyle="bold" android:textColor="#2563EB" android:letterSpacing="0.10"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Choose a session below or scan the teacher's code." android:textSize="15sp" android:textStyle="bold" android:textColor="#172033" android:gravity="center" android:layout_marginTop="6dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your attendance will be linked to your student account." android:textSize="12sp" android:textColor="#64748B" android:gravity="center" android:layout_marginTop="4dp"/></LinearLayout></androidx.cardview.widget.CardView>
</LinearLayout></ScrollView>
