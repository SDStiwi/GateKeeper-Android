<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:fillViewport="true">
<LinearLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="28dp">
    <LinearLayout android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="18dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TEACHER" android:textSize="11sp" android:textStyle="bold" android:textColor="#2563EB" android:letterSpacing="0.16"/>
            <TextView android:id="@+id/txtName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="John Doe" android:textSize="27sp" android:textStyle="bold" android:textColor="#172033" android:fontFamily="@font/poppins_bold" android:layout_marginTop="3dp"/>
            <TextView android:id="@+id/txtDepartment" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Science" android:textSize="13sp" android:textColor="#64748B" android:layout_marginTop="2dp"/>
            <TextView android:id="@+id/txtEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="teacher1@example.com" android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="1dp"/>
        </LinearLayout>
        <TextView android:layout_width="52dp" android:layout_height="52dp" android:gravity="center" android:text="TG" android:textSize="15sp" android:textStyle="bold" android:textColor="#173B73" android:background="@drawable/pill_blue"/>
    </LinearLayout>
    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardCornerRadius="20dp" app:cardElevation="0dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp" android:background="#F7FAFF">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATTENDANCE CONTROL CENTER" android:textSize="10sp" android:textStyle="bold" android:textColor="#2563EB" android:letterSpacing="0.08"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Everything you need for today's classes" android:textSize="20sp" android:textStyle="bold" android:textColor="#172033" android:fontFamily="@font/poppins_bold" android:layout_marginTop="4dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Monitor sessions, rooms, attendance and student requests from one dashboard." android:textSize="12sp" android:textColor="#64748B" android:layout_marginTop="4dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="14dp">
                <TextView android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="LIVE SESSIONS" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B73" android:background="@drawable/pill_blue"/>
                <Space android:layout_width="8dp" android:layout_height="1dp"/>
                <TextView android:layout_width="0dp" android:layout_height="38dp" android:layout_weight="1" android:gravity="center" android:text="ROOM ACCESS" android:textSize="10sp" android:textStyle="bold" android:textColor="#173B73" android:background="@drawable/pill_blue"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY'S SCHEDULE" android:textSize="11sp" android:textStyle="bold" android:textColor="#173B73" android:letterSpacing="0.10" android:layout_marginBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewSchedule" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:clipToPadding="false"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ROOMS TODAY" android:textSize="11sp" android:textStyle="bold" android:textColor="#173B73" android:letterSpacing="0.10" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewRooms" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:clipToPadding="false"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LATEST NOTIFICATIONS" android:textSize="11sp" android:textStyle="bold" android:textColor="#173B73" android:letterSpacing="0.10" android:layout_marginTop="20dp" android:layout_marginBottom="8dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewNotifications" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:clipToPadding="false"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/btnViewAttendance" android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="14dp" android:text="View attendance records" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/button_primary" app:cornerRadius="14dp"/>
</LinearLayout></ScrollView>
