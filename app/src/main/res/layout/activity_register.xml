<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF" android:fillViewport="true" tools:context=".RegisterActivity">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:paddingTop="44dp" android:paddingBottom="28dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GATEKEEPER" android:textSize="12sp" android:textStyle="bold" android:textColor="#2563EB" android:letterSpacing="0.18"/>
    <TextView android:id="@+id/sign_up_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Create an account" android:textSize="30sp" android:textColor="#172033" android:fontFamily="@font/poppins_bold" android:layout_marginTop="5dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Set up your academic profile to access GateKeeper." android:textSize="13sp" android:textColor="#64748B" android:layout_marginTop="5dp" android:layout_marginBottom="22dp"/>
    <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="22dp" app:cardElevation="0dp" xmlns:app="http://schemas.android.com/apk/res-auto">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/card_surface">
        <TextView android:id="@+id/first_name_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="First name" android:textSize="13sp" android:textStyle="bold" android:textColor="#334155"/>
        <EditText android:id="@+id/editTextFirstName" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/edit_text_background" android:textColor="#172033" android:layout_marginBottom="14dp"/>
        <TextView android:id="@+id/last_name_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Last name" android:textSize="13sp" android:textStyle="bold" android:textColor="#334155"/>
        <EditText android:id="@+id/editTextLastName" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/edit_text_background" android:textColor="#172033" android:layout_marginBottom="14dp"/>
        <TextView android:id="@+id/email_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Email" android:textSize="13sp" android:textStyle="bold" android:textColor="#334155"/>
        <EditText android:id="@+id/editTextEmail" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/edit_text_background" android:textColor="#172033" android:inputType="textEmailAddress" android:layout_marginBottom="14dp"/>
        <TextView android:id="@+id/password_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Password" android:textSize="13sp" android:textStyle="bold" android:textColor="#334155"/>
        <EditText android:id="@+id/editTextPassword" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/edit_text_background" android:textColor="#172033" android:inputType="textPassword" android:layout_marginBottom="14dp"/>
        <TextView android:id="@+id/department_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Department" android:textSize="13sp" android:textStyle="bold" android:textColor="#334155"/>
        <EditText android:id="@+id/departement" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:background="@drawable/edit_text_background" android:textColor="#172033" android:layout_marginBottom="14dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Account type" android:textSize="13sp" android:textStyle="bold" android:textColor="#334155" android:layout_marginBottom="4dp"/>
        <RadioGroup android:id="@+id/radioGroupRole" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:background="@drawable/info_item_bg" android:padding="6dp">
            <RadioButton android:id="@+id/radioTeacher" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Teacher" android:textColor="#173B73" android:buttonTint="#2563EB"/>
            <RadioButton android:id="@+id/radioStudent" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Student" android:textColor="#173B73" android:buttonTint="#2563EB"/>
        </RadioGroup>
        <Spinner android:id="@+id/spinnerSpeciality" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:background="@drawable/spinner_border" android:padding="4dp" android:entries="@array/speciality_array" android:visibility="gone" />
        <Button android:id="@+id/btnRegister" android:layout_width="match_parent" android:layout_height="54dp" android:text="Create account" android:textAllCaps="false" android:textColor="#FFFFFF" android:backgroundTint="#173B73" android:layout_marginTop="20dp"/>
        <TextView android:id="@+id/signinlink" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Already have an account? Sign in" android:textSize="13sp" android:textColor="#2563EB" android:gravity="center" android:layout_marginTop="14dp"/>
        <TextView android:id="@+id/textApprovalMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your account requires approval by the admin." android:textSize="13sp" android:textColor="#B45309" android:visibility="gone" android:layout_marginTop="12dp" android:gravity="center"/>
    </LinearLayout></androidx.cardview.widget.CardView>
</LinearLayout></ScrollView>
