<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCHEDULE" android:textSize="11sp" android:textStyle="bold" android:textColor="#2563EB" android:letterSpacing="0.14"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Your weekly schedule" android:textSize="28sp" android:textStyle="bold" android:textColor="#172033" android:fontFamily="@font/poppins_bold" android:layout_marginTop="4dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Classes, rooms and times in one view." android:textSize="13sp" android:textColor="#64748B" android:layout_marginTop="4dp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Color-coded by course · today is highlighted" android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="8dp"/>
</LinearLayout>
<androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp" app:cardCornerRadius="18dp" app:cardElevation="0dp">
<HorizontalScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:scrollbars="horizontal"><TableLayout android:id="@+id/tableLayoutTimetable" android:layout_width="wrap_content" android:layout_height="wrap_content" android:padding="6dp">
<TableRow android:background="#173B73"><TextView android:layout_width="82dp" android:layout_height="46dp" android:gravity="center" android:text="TIME" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="10sp"/><TextView android:layout_width="125dp" android:layout_height="46dp" android:gravity="center" android:text="MON" android:textColor="#FFFFFF" android:textStyle="bold"/><TextView android:layout_width="125dp" android:layout_height="46dp" android:gravity="center" android:text="TUE" android:textColor="#FFFFFF" android:textStyle="bold"/><TextView android:layout_width="125dp" android:layout_height="46dp" android:gravity="center" android:text="WED" android:textColor="#FFFFFF" android:textStyle="bold"/><TextView android:layout_width="125dp" android:layout_height="46dp" android:gravity="center" android:text="THU" android:textColor="#FFFFFF" android:textStyle="bold"/><TextView android:layout_width="125dp" android:layout_height="46dp" android:gravity="center" android:text="FRI" android:textColor="#FFFFFF" android:textStyle="bold"/></TableRow>
<TableRow><TextView android:layout_width="82dp" android:layout_height="82dp" android:gravity="center" android:text="09:00" android:textColor="#64748B" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/time_cell_bg"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/></TableRow>
<TableRow><TextView android:layout_width="82dp" android:layout_height="82dp" android:gravity="center" android:text="11:00" android:textColor="#64748B" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/time_cell_bg"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/></TableRow>
<TableRow><TextView android:layout_width="82dp" android:layout_height="82dp" android:gravity="center" android:text="12:30" android:textColor="#64748B" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/time_cell_bg"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/></TableRow>
<TableRow><TextView android:layout_width="82dp" android:layout_height="82dp" android:gravity="center" android:text="14:00" android:textColor="#64748B" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/time_cell_bg"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/></TableRow>
<TableRow><TextView android:layout_width="82dp" android:layout_height="82dp" android:gravity="center" android:text="15:30" android:textColor="#64748B" android:textStyle="bold" android:textSize="12sp" android:background="@drawable/time_cell_bg"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/><TextView style="@style/EnhancedClassCell" android:layout_width="125dp" android:layout_height="82dp"/></TableRow>
</TableLayout></HorizontalScrollView></androidx.cardview.widget.CardView>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="Swipe horizontally to view all days" android:textSize="11sp" android:textColor="#94A3B8" android:paddingBottom="10dp"/>
</LinearLayout>
