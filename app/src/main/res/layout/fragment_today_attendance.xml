<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="#FFFFFF" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATTENDANCE LOG"
        android:textSize="12sp" android:textStyle="bold" android:textColor="#64748B" android:letterSpacing="0.08"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today’s check-ins"
        android:textSize="25sp" android:textStyle="bold" android:textColor="#172033" android:fontFamily="@font/poppins_bold" android:layout_marginTop="3dp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Live records from QR attendance sessions."
        android:textSize="12sp" android:textColor="#94A3B8" android:layout_marginTop="3dp" android:layout_marginBottom="12dp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerViewAttendance" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp"/>
</LinearLayout>
