<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/qrFragment" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FFFFFF">
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="32dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ATTENDANCE CONTROL" android:textSize="11sp" android:textStyle="bold" android:textColor="#2563EB" android:letterSpacing="0.14"/>
<TextView android:id="@+id/qrTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Session QR code" android:textSize="29sp" android:textColor="#172033" android:fontFamily="@font/poppins_bold" android:textStyle="bold" android:layout_marginTop="4dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Students scan this code to register attendance for the active class." android:textSize="13sp" android:textColor="#64748B" android:layout_marginTop="4dp"/>
<TextView android:id="@+id/classNameTextView" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Class: Software Engineering" android:textSize="14sp" android:textColor="#173B73" android:textStyle="bold" android:background="@drawable/pill_blue" android:paddingHorizontal="14dp" android:paddingVertical="9dp" android:layout_marginTop="14dp"/>
<LinearLayout android:id="@+id/qrCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/enhanced_qr_code_bg" android:padding="18dp" android:layout_marginTop="14dp" android:gravity="center_horizontal">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SCAN TO MARK ATTENDANCE" android:textSize="10sp" android:textColor="#64748B" android:textStyle="bold" android:letterSpacing="0.08" android:layout_marginBottom="12dp"/>
<FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/qr_frame_border" android:padding="10dp"><ImageView android:id="@+id/qrCodeImageView" android:layout_width="250dp" android:layout_height="250dp" android:contentDescription="QR Code" android:background="#FFFFFF" android:padding="5dp"/></FrameLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Valid for the current session" android:textSize="11sp" android:textColor="#94A3B8" android:layout_marginTop="12dp"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/btnScanQRCode" android:layout_width="match_parent" android:layout_height="52dp" android:text="Scan QR code" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFF" android:background="@drawable/button_primary" app:cornerRadius="14dp" android:layout_marginTop="14dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/btnCloseDoor" android:layout_width="match_parent" android:layout_height="52dp" android:text="Close door" android:textAllCaps="false" android:textSize="14sp" android:textStyle="bold" android:textColor="#173B73" android:backgroundTint="#FFFFFF" app:strokeColor="#C7D5E6" app:cornerRadius="14dp" android:layout_marginTop="9dp"/>
</LinearLayout></ScrollView></FrameLayout>
